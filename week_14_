# Advanced exercise 

# Function to calculate statistics
def calculate_statistics(*args):
    count = len(args)
    total = sum(args)
    average = total / count if count > 0 else 0
    return (count, total, average)

# Function to update student records
def update_student_records(students, bonus):
    updated = []
    for name, grade in students:
        new_grade = grade + bonus
        updated.append((name, new_grade))  # create a new tuple
    return updated

# Original student records
students = [("Alice", 85), ("Bob", 78), ("Charlie", 90)]

# Update grades with a bonus
updated_students = update_student_records(students, 5)

# Extract updated grades to pass into statistics function
grades = [grade for _, grade in updated_students]

# Calculate statistics using unpacking
stats = calculate_statistics(*grades)

# Print results
print("Original records:", students)
print("Updated records:", updated_students)
print("Statistics (count, sum, average):", stats)

