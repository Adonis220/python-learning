# advanced 

# Create a 4x4 multiplication table using nested list comprehension
table = [[row * col for col in range(1, 5)] for row in range(1, 5)]

# Print the table in a formatted way
print("Multiplication Table:")
for row in table:
    for value in row:
        print(f"{value:3}", end=" ")
    print()

# Function to sum diagonal elements
def sum_diagonal(matrix):
    return sum(matrix[i][i] for i in range(len(matrix)))

# Test the function
diagonal_sum = sum_diagonal(table)
print("\nDiagonal sum:", diagonal_sum)

# Generator expression for even numbers in the table
even_numbers = (value for row in table for value in row if value % 2 == 0)

# Print first 5 even numbers
print("\nFirst 5 even numbers:")
for i, num in enumerate(even_numbers):
    if i == 5:
        break
    print(num)

